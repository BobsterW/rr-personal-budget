{
  "name": "@rr-budget/worker",
  "version": "7.10.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "bcryptjs": "3.0.2"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply rr-budget --local",
    "db:seed:local": "wrangler d1 execute rr-budget --local --file ../database/seeds/development.sql"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "eslint": "9.34.0",
    "typescript-eslint": "8.40.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.124.0"
  }
}
